{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wangstock",
  "version": "1.0.0",
  "identifier": "com.wangstock.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "wangstock",
        "width": 960,
        "height": 640,
        "minWidth": 760,
        "minHeight": 460,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#121214"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
